{
    "name": "student/laravel-pos-foundations",
    "type": "project",
    "description": "EnzoTFA7 Laravel Forms, Validation, and File Upload activity for IT0049.",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "intervention/image-laravel": "^1.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "dev": [
            "php artisan serve"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
